{
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": ".tsbuild/worker",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types", "node", "@cloudflare/vitest-plugin/types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@burrow/sdk": ["./packages/sdk/src/index.ts"],
      "@burrow/core": ["./packages/core/src/index.ts"],
      "@burrow/core/*": ["./src/core/*"],
      "@burrow/worker": ["./packages/worker/src/index.ts"],
      "@burrow/worker/*": ["./src/worker/*"],
      "@burrow/plugins": ["./packages/plugins/src/index.ts"],
      "@burrow/plugins/*": ["./packages/plugins/*"]
    }
  },
  "include": [
    "src/worker",
    "src/server",
    "src/shared",
    "src/core",
    "packages/core/src",
    "packages/worker/src",
    "packages/plugins/src",
    "tests/api",
    "tests/unit",
    "tests/adapters"
  ],
  "references": [{ "path": "./packages/sdk" }]
}
