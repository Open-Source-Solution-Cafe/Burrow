{
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": ".tsbuild/web",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@burrow/sdk": ["./packages/sdk/src/index.ts"],
      "@burrow/core": ["./packages/core/src/index.ts"],
      "@burrow/core/*": ["./src/core/*"],
      "@burrow/web": ["./packages/web/src/index.ts"],
      "@burrow/web/*": ["./src/web/*"],
      "@burrow/plugins": ["./packages/plugins/src/index.ts"],
      "@burrow/plugins/*": ["./packages/plugins/*"]
    }
  },
  "include": ["src/web", "src/shared", "packages/web/src", "packages/plugins/estimation/src"],
  "references": [{ "path": "./packages/sdk" }, { "path": "./tsconfig.worker.json" }]
}
