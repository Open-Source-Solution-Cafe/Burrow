# Auto detect text files and perform LF normalization on checkout
* text=auto eol=lf

# Force LF on database scripts, schemas, and configurations
*.sql text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

