{
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": ".tsbuild/core",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "baseUrl": ".",
    "paths": {
      "@burrow/sdk": ["./packages/sdk/src/index.ts"],
      "@burrow/core": ["./packages/core/src/index.ts"],
      "@burrow/core/*": ["./src/core/*"],
      "@burrow/plugins": ["./packages/plugins/src/index.ts"],
      "@burrow/plugins/*": ["./packages/plugins/*"]
    }
  },
  "include": ["src/core"],
  "references": [{ "path": "./packages/sdk" }, { "path": "./tsconfig.worker.json" }]
}
