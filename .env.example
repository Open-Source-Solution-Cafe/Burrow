# ==============================================================================
# Burrow — Environment Configuration (Self-Hosted / Public)
# ==============================================================================
# All setup and dev commands work out-of-the-box without a .env file
# and print active credentials/resource IDs directly to the console.
# Copy this file to .env to customize your configuration.
# ==============================================================================

# ------------------------------------------------------------------------------
# TIER 1: Core Required Configuration (for Production Self-Hosting)
# ------------------------------------------------------------------------------
# Database URL (PostgreSQL) or omit to use embedded local SQLite
# DATABASE_URL=postgres://burrow_user:supersecretpassword123@localhost:5432/burrow_prod_db

# Better Auth session encryption key (must be at least 32 characters in production)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-secret-change-me-32-bytes-minimum!!

# Canonical public application URL
BETTER_AUTH_URL=http://localhost:3005

# Bootstrap Token (required on first setup of self-hosted instance, >= 16 chars)
# Leave blank in dev to auto-generate a secure token printed to the console
BOOTSTRAP_TOKEN=


# ------------------------------------------------------------------------------
# TIER 2: Application Defaults (Optional)
# ------------------------------------------------------------------------------
PORT=3005
NODE_ENV=development

# Local disk storage path (used by default when S3 / R2 is not configured)
# LOCAL_STORAGE_PATH=./data/uploads


# ------------------------------------------------------------------------------
# TIER 3: Optional Integrations (Email, Cloudflare, S3 Object Storage)
# ------------------------------------------------------------------------------

# --- Email Delivery (Resend) ---
# Without these, invite emails are logged directly to the server console.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM=Burrow <notify@yourdomain.com>

# --- S3 / MinIO / Tigris Object Storage ---
# Alternative to local disk storage:
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=burrow-files
# S3_ACCESS_KEY=your-access-key-id
# S3_SECRET_KEY=your-secret-access-key
# S3_FORCE_PATH_STYLE=false

# --- Cloudflare Workers & D1 Deployment (Only needed for CF Workers runtime) ---
# Auto-discovered by scripts via Wrangler if omitted:
# D1_DATABASE_ID=
# CLOUDFLARE_ACCOUNT_ID=

