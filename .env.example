# ==============================================================================
# Burrow — Environment Configuration (Self-Hosted / Public)
# ==============================================================================
# All setup, dev, and Cloudflare deploy workflows work out-of-the-box without
# editing this file (Cloudflare Deploy prompts for any uncommented KEY=VALUE lines).
# Copy this file to .env to customize your configuration, or run:
#   pnpm run docker:init -- --url https://notes.example.com
# ==============================================================================

# ------------------------------------------------------------------------------
# TIER 1: Core Configuration (Uncomment in .env for Production Docker / Custom URL)
# ------------------------------------------------------------------------------
# Database URL (PostgreSQL) or omit to use embedded local SQLite / Cloudflare D1
# DATABASE_URL=postgres://burrow_user:supersecretpassword123@localhost:5432/burrow_prod_db

# Better Auth session encryption key (must be at least 32 characters in production)
# Auto-generated and persisted in D1 on Cloudflare Workers if omitted.
# Generate for Docker with: openssl rand -hex 32 (or pnpm run docker:init)
# BETTER_AUTH_SECRET=

# Canonical public application URL (auto-derived from HTTPS request on Cloudflare Workers)
# BETTER_AUTH_URL=http://localhost:3005

# Host bind IP for Docker Compose port publishing (keep 127.0.0.1 for local evaluation or behind a reverse proxy)
# BIND_HOST=127.0.0.1

# Explicit opt-in required to run NODE_ENV=production on http://localhost:3005 for local Docker evaluation.
# Keep false for internet-accessible production deployments.
# ALLOW_LOCAL_DOCKER_EVAL=false

# Bootstrap Token (optional >= 16-char secret to gate initial Owner registration).
# Omit for zero-input setup where the first user to register at /login claims Owner.
# Generate for Docker with: openssl rand -hex 16 (or pnpm run docker:init)
# BOOTSTRAP_TOKEN=

# PostgreSQL credentials for Docker Compose (generate with: pnpm run docker:init)
# POSTGRES_USER=burrow
# POSTGRES_PASSWORD=
# POSTGRES_DB=burrow


# ------------------------------------------------------------------------------
# TIER 2: Application Defaults (Optional)
# ------------------------------------------------------------------------------
# PORT=3005
# NODE_ENV=development

# Local disk storage path (used by default when S3 / R2 is not configured)
# LOCAL_STORAGE_PATH=./data/uploads


# ------------------------------------------------------------------------------
# TIER 3: Optional Integrations (Email, Cloudflare, S3 Object Storage)
# ------------------------------------------------------------------------------

# --- Email Delivery (Resend) ---
# Without these, invite emails are logged directly to the server console.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM=Burrow <notify@yourdomain.com>

# --- S3 / MinIO / Tigris Object Storage ---
# Alternative to local disk storage:
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=burrow-files
# S3_ACCESS_KEY=your-access-key-id
# S3_SECRET_KEY=your-secret-access-key
# S3_FORCE_PATH_STYLE=false

# --- Legal & Privacy Notice Links (Optional) ---
# Shown on /login and Settings -> Profile & Account when configured:
# PRIVACY_POLICY_URL=https://example.com/privacy
# TERMS_OF_SERVICE_URL=https://example.com/terms

# --- One-Click Self-Update Webhook (Optional) ---
# Trigger GitLab CI, GitHub Actions, or container rebuild webhook from Settings -> System & Core Updates:
# SELF_UPDATE_WEBHOOK_URL=
# SELF_UPDATE_WEBHOOK_TOKEN=
# SELF_UPDATE_WEBHOOK_REF=main

# --- Cloudflare Workers & D1 Deployment (Only needed for CF Workers runtime) ---
# Auto-discovered by scripts via Wrangler if omitted:
# D1_DATABASE_ID=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_DOMAIN=
# STAGING_D1_DATABASE_ID=

